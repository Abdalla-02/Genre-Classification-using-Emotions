    "seeds": [
      42,
      1,
      2,
      3,
      4
    ],
    "arm_labels": {
      "ground-truth emotion(11) [ceiling]": "ratings (ceiling)",
      "VGGish -> predicted emotion(11), OOF-trained": "emotion route",
